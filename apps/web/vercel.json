{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "*/10 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/*": false,
      "feature/*": false,
      "infra/*": false,
      "fix/*": false,
      "chore/*": false,
      "docs/*": false
    }
  }
}
