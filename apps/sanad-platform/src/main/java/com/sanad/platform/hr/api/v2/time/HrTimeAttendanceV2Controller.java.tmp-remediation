    @GetMapping("/leave/balances")
    @Operation(operationId = "hrLeaveBalancesList")
    @RequireCapability(TimeAttendanceCapabilities.LEAVE_SELF_VIEW)
    public ResponseEntity<List<HrLeaveBalanceResponse>> listLeaveBalances(
            Authentication authentication,
            @RequestParam(required = false) UUID employmentId,
            @RequestParam(required = false) Integer year
    ) {
        UUID tenantId = SecurityContextUtils.tenantId(authentication);
        UUID self = accessScope.requireSelfEmployment(
                tenantId, SecurityContextUtils.userId(authentication), employmentId);
        int y = year != null ? year : LocalDate.now().getYear();
        return ResponseEntity.ok(leaveService.listLeaveBalances(tenantId, self, y));
    }

    @GetMapping("/time/attendance/monthly-report")
    @Operation(operationId = "hrAttendanceMonthlyReport")
    public ResponseEntity<List<MonthlyAttendanceReportRow>> monthlyAttendanceReport(
            Authentication authentication,
            @RequestParam int year,
            @RequestParam int month,
            @RequestParam(required = false) UUID employmentId
    ) {
        UUID tenantId = SecurityContextUtils.tenantId(authentication);
        UUID userId = SecurityContextUtils.userId(authentication);
        if (hasAny(authentication,
                TimeAttendanceCapabilities.ATTENDANCE_ADMIN,
                TimeAttendanceCapabilities.ATTENDANCE_CORRECT)) {
            return ResponseEntity.ok(timeService.monthlyAttendanceReport(tenantId, year, month, employmentId));
        }
        if (hasCapability(authentication, TimeAttendanceCapabilities.ATTENDANCE_TEAM_VIEW)) {
            List<MonthlyAttendanceReportRow> rows = new ArrayList<>();
            for (UUID reportId : restrictRequested(accessScope.directReportEmploymentIds(tenantId, userId), employmentId)) {
                rows.addAll(timeService.monthlyAttendanceReport(tenantId, year, month, reportId));
            }
            return ResponseEntity.ok(rows);
        }
        throw denied("Attendance report capability is required");
    }

    private List<HrAttendanceRecordResponse> flatMapAttendance(
            UUID tenantId, List<UUID> employmentIds, LocalDate startDate, LocalDate endDate) {
        List<HrAttendanceRecordResponse> rows = new ArrayList<>();
        for (UUID id : employmentIds) rows.addAll(timeService.listAttendance(tenantId, id, startDate, endDate));
        return rows;
    }

    private List<HrTimesheetService.TimesheetResponse> flatMapTimesheets(
            UUID tenantId, List<UUID> employmentIds, String state) {
        List<HrTimesheetService.TimesheetResponse> rows = new ArrayList<>();
        for (UUID id : employmentIds) rows.addAll(timesheetService.listTimesheets(tenantId, id, state));
        return rows;
    }

    private List<HrLeaveRequestResponse> flatMapLeaveRequests(
            UUID tenantId, List<UUID> employmentIds, String state) {
        Map<UUID, HrLeaveRequestResponse> deduped = new LinkedHashMap<>();
        for (UUID id : employmentIds) {
            for (HrLeaveRequestResponse row : leaveService.listLeaveRequests(tenantId, id, state)) {
                deduped.put(row.id(), row);
            }
        }
        return List.copyOf(deduped.values());
    }

    private List<UUID> restrictRequested(List<UUID> allowed, UUID requested) {
        if (requested == null) return allowed;
        if (!allowed.contains(requested)) throw denied("Requested employee is outside TEAM scope");
        return List.of(requested);
    }

    private void requireAny(Authentication authentication, String... capabilities) {
        if (!hasAny(authentication, capabilities)) throw denied("Required HR capability is missing");
    }

    private boolean hasAny(Authentication authentication, String... capabilities) {
        for (String capability : capabilities) if (hasCapability(authentication, capability)) return true;
        return false;
    }

    private boolean hasCapability(Authentication authentication, String capability) {
        if (authentication == null || !authentication.isAuthenticated()) return false;
        String prefixed = "CAPABILITY_" + capability;
        return authentication.getAuthorities().stream().anyMatch(authority ->
                capability.equalsIgnoreCase(authority.getAuthority())
                        || prefixed.equalsIgnoreCase(authority.getAuthority()));
    }

    private AccessDeniedException denied(String message) {
        return new AccessDeniedException(message);
    }

    public record ClockInRequest(UUID employmentId, LocalDate recordDate) {}
    public record CreateLeaveRequest(UUID employmentId, UUID leaveTypeId, LocalDate startDate, LocalDate endDate, String reason, String attachmentUrl) {}
    public record ApproveLeaveRequest(String comment) {}
    public record RejectLeaveRequest(String reason) {}
    public record CreateLeaveRequestResponse(UUID requestId) {}

    public record HrAttendanceRecordResponse(
            UUID id, UUID employmentId, LocalDate recordDate,
            java.time.Instant clockIn, java.time.Instant clockOut,
            Integer breakMinutes, Integer workedMinutes, String source, String state
    ) {}

    public record HrLeaveTypeResponse(
            UUID id, String code, String nameAr, String nameEn,
            Boolean isPaid, Boolean requiresAttachment, Integer defaultDaysPerYear, String state
    ) {}

    public record HrLeaveRequestResponse(
            UUID id, UUID employmentId, UUID leaveTypeId,
            LocalDate startDate, LocalDate endDate, java.math.BigDecimal daysCount,
            String reason, String state, java.time.Instant submittedAt,
            java.time.Instant approvedAt, String approverComment
    ) {}

    public record HrLeaveBalanceResponse(
            UUID id, UUID employmentId, UUID leaveTypeId, Integer year,
            java.math.BigDecimal entitledDays, java.math.BigDecimal usedDays,
            java.math.BigDecimal pendingDays, java.math.BigDecimal carriedOverDays
    ) {}

    public record MonthlyAttendanceReportRow(
            UUID employmentId,
            Integer scheduledDays,
            Integer scheduledMinutes,
            Integer workedMinutes,
            Integer absentDays,
            Integer leaveDays,
            Integer lateOccurrences,
            Integer earlyDepartures,
            Integer missingPunches,
            String attendanceStatus
    ) {}

    public record CreateIdResponse(UUID id) {}
    public record CreateTimesheetRequest(UUID employmentId, LocalDate periodStart, LocalDate periodEnd) {}
    public record ApproveRejectRequest(String comment, String reason) {}
}
