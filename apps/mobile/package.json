{
  "name": "sanad-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~52.0.0",
    "expo-crypto": "~14.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sqlite": "~15.0.0",
    "react": "19.2.8",
    "react-native": "0.79.4",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-test-renderer": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.8.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "node:ts",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "transform": {
          "^.+\\.tsx?$": "ts-jest"
        },
        "moduleFileExtensions": [
          "ts",
          "tsx",
          "js",
          "jsx",
          "json"
        ],
        "testMatch": [
          "**/__tests__/**/*.test.ts"
        ],
        "globals": {
          "__DEV__": true
        }
      },
      {
        "displayName": "rn:components",
        "preset": "./node_modules/react-native/jest-preset",
        "testMatch": [
          "**/__tests__/action-center.test.tsx"
        ],
        "globals": {
          "__DEV__": true
        }
      }
    ]
  }
}
